{
  "name": "dsh-ai-soul",
  "version": "0.0.1",
  "description": "Persistent identity layer for DeepSeek Harness",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core/index.js",
    "./profile-preflight": "./src/profile-preflight.js",
    "./profile-configure": "./src/profile-configure.js",
    "./exodus-prepare": "./src/exodus-prepare.js",
    "./exodus-review-prepare": "./src/exodus-review-prepare.js",
    "./exodus-review-update": "./src/exodus-review-update.js",
    "./lifecycle-import-prepare": "./src/lifecycle-import-prepare.js"
  },
  "bin": {
    "dsh-ai-soul-configure": "./src/cli/configure-dsh-profile.js",
    "dsh-ai-soul-preflight": "./src/cli/preflight-dsh-profile.js",
    "dsh-ai-soul-exodus-prepare": "./src/cli/prepare-exodus-markdown.js",
    "dsh-ai-soul-exodus-review": "./src/cli/prepare-exodus-review.js",
    "dsh-ai-soul-exodus-review-update": "./src/cli/update-exodus-review.js",
    "dsh-ai-soul-import-prepare": "./src/cli/prepare-lifecycle-import.js"
  },
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/preflight.js && node --check src/profile-preflight.js && node --check src/profile-configure.js && node --check src/exodus-prepare.js && node --check src/exodus-review-prepare.js && node --check src/exodus-review-update.js && node --check src/lifecycle-import-prepare.js && node --check src/core/lifecycle-import-reconciliation.js && node --check src/cli/preflight-dsh-profile.js && node --check src/cli/configure-dsh-profile.js && node --check src/cli/prepare-exodus-markdown.js && node --check src/cli/prepare-exodus-review.js && node --check src/cli/update-exodus-review.js && node --check src/cli/prepare-lifecycle-import.js && node --test",
    "bootstrap:samuel": "node examples/bootstrap-samuel.js",
    "preflight:soul": "node examples/preflight-soul.js",
    "preflight:dsh-profile": "node src/cli/preflight-dsh-profile.js",
    "configure:dsh-profile": "node src/cli/configure-dsh-profile.js",
    "exodus:prepare": "node src/cli/prepare-exodus-markdown.js",
    "exodus:review": "node src/cli/prepare-exodus-review.js",
    "exodus:review:update": "node src/cli/update-exodus-review.js",
    "import:prepare": "node src/cli/prepare-lifecycle-import.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "ai-soul",
    "persistent-identity",
    "ai-agent"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
