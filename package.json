{
  "name": "dsh-ai-soul",
  "version": "0.0.1",
  "description": "Persistent identity layer for DeepSeek Harness",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core/index.js",
    "./profile-preflight": "./src/profile-preflight.js"
  },
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/preflight.js && node --check src/profile-preflight.js && node --check src/cli/preflight-dsh-profile.js && node --test",
    "bootstrap:samuel": "node examples/bootstrap-samuel.js",
    "preflight:soul": "node examples/preflight-soul.js",
    "preflight:dsh-profile": "node src/cli/preflight-dsh-profile.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "ai-soul",
    "persistent-identity",
    "ai-agent"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
